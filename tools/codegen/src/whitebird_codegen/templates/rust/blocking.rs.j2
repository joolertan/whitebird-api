impl Client {
{{ accessors(view.accessors, "self") }}
}
{% for resource in view.resources %}

{{ resource_struct(resource) }}

{% call resource_impl(resource) %}
{% for method in resource.methods %}

{% for line in method.blocking_docs %}
    {{ line }}
{% endfor %}
{% for attr in method.attrs %}
    {{ attr }}
    #[allow(deprecated)]
{% endfor %}
    pub fn {{ method.name }}(&self{{ method.args }}) -> {{ method.returns }} {
{% if method.is_async %}
        self.client.block_on(self.client.as_async(){{ resource.chain }}.{{ method.name }}({{ method.call_args }}))
{% else %}
        {{ method.blocking_stream }}::new(self.client, self.client.as_async(){{ resource.chain }}.{{ method.name }}({{ method.call_args }}))
{% endif %}
    }
{% endfor %}
