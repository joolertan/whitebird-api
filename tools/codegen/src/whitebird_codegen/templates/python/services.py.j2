# {{ HEADER }}
"""Hosts of the Whitebird services and the authentication endpoints of the web application."""

from typing import Final, Literal

Environment = Literal[{{ ir.environments | map("literal") | join(", ") }}]
"""Deployment to connect to. A service missing from an environment uses its production host."""

SERVICE_URLS: Final[dict[str, dict[str, str]]] = {
{% for key, service in ir.services.items() %}
    {{ key | literal }}: { {%- for environment, url in service.urls.items() %}{{ environment | literal }}: {{ url | literal }}{{ ", " if not loop.last }}{% endfor -%} },
{% endfor %}
}
"""Base URL of every service, by environment."""

OAUTH_SERVICE: Final = {{ ir.oauth.service | literal }}
"""Service that issues OAuth tokens."""

OAUTH_TOKEN_PATH: Final = {{ ir.oauth.token_path | literal }}
"""Path of the OAuth token endpoint."""

OAUTH_BASIC: Final = {{ ir.oauth.basic | literal }}
"""HTTP Basic credentials of the public web client, sent to the token endpoint."""

OAUTH_MFA_STATUS_PATH: Final = {{ ir.oauth.mfa_status_path | literal }}
"""Path on the OAuth service telling whether an account has two-factor authentication."""

OAUTH_CAPTCHA_PATH: Final = {{ ir.oauth.captcha_path | literal }}
"""Path on the OAuth service that generates the slider captcha of the sign-in form."""

OPERATION_MFA_SERVICE: Final = {{ ir.operation_mfa.service | literal }}
"""Service that issues operation MFA tokens."""

OPERATION_MFA_TOKEN_PATH: Final = {{ ir.operation_mfa.token_path | literal }}
"""Path exchanging a one-time code for the `x-mfa-token` of a sensitive operation."""
