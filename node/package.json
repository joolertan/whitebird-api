{
  "name": "whitebird-api",
  "version": "0.1.0",
  "description": "Unofficial Whitebird API client",
  "keywords": [
    "whitebird",
    "crypto",
    "exchange",
    "brokerage",
    "api",
    "client",
    "sdk"
  ],
  "homepage": "https://whitebird-api.readthedocs.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joolertan/whitebird-api.git",
    "directory": "node"
  },
  "bugs": "https://github.com/joolertan/whitebird-api/issues",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./otp": {
      "import": {
        "types": "./dist/otp.d.ts",
        "default": "./dist/otp.js"
      },
      "require": {
        "types": "./dist/otp.d.cts",
        "default": "./dist/otp.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "otp": [
        "./dist/otp.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
